{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // A transitive dep pulls in the deprecated @types/minimatch stub, which has
    // no type definitions and breaks the implicit "include every @types" rule.
    "types": ["node", "mocha", "chai"],
    "outDir": "dist",
    "declaration": true
  },
  "include": [
    "./scripts",
    "./test",
    "./tasks",
    "./config",
    "./utils",
    "./typechain-types"
  ],
  "files": ["./hardhat.config.ts"]
}
