# RPC provider — at least one key is required for any non-local network.
# ALCHEMY_KEY takes precedence over INFURA_KEY when both are set.
ALCHEMY_KEY=<string?>
INFURA_KEY=<string?>

# Deployment accounts.
MNEMONIC_DEV=<string>
MNEMONIC_PROD=<string>

FORKING_NETWORK=<main | sepolia>
ETHERSCAN_API_KEY=<string>
OPTIMIZER=<true | false>
REPORT_GAS=<true | false>

# Deployed SignatureVerify address, printed by scripts/deploy.ts.
SIGNATURE_VERIFY_ADDRESS=<address>

# Contracts whose callers get blacklisted, comma-separated.
FORBIDDEN_ADDRESSES=<address,address,...>

# Per-run argument for scripts/checkIsBanned.ts.
CHECK_ADDRESS=<address?>

# Port of the `local` network node. Defaults to 8545; change it if another
# node is already listening there.
LOCAL_RPC_PORT=<number?>
